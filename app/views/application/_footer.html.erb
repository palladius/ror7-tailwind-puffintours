<footer class="mx-auto mt-20 w-full max-w-7xl px-4 sm:px-6 lg:px-8 pb-10">
  <div class="glass-panel rounded-3xl px-6 py-8 text-center">
    <div class="inline-flex items-center gap-2 rounded-full bg-amber-500/10 border border-amber-500/20 px-4 py-1 text-xs font-semibold text-amber-800 mb-3">
      <span>🐧 <%= AppName %></span>
      <span>•</span>
      <span>v<%= AppVersion %></span>
      <span>•</span>
      <span>Rails <%= Rails.version %></span>
      <% if DEBUG %>
        <span class="text-red-600 font-bold">🐞 DEBUG</span>
      <% end %>
    </div>
    <div class="mt-3 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm font-medium text-slate-600">
      <%= link_to "About Us", page_path(:about_us), class: "hover:text-amber-700 no-underline" %>
      <span class="text-slate-300">•</span>
      <%= link_to "Design Doc", 'https://docs.google.com/document/d/1gN5f2-9vNwvgS4H029dp6vrPTP2rQU9SnvMToYrq2Ec/edit', class: "hover:text-amber-700 no-underline", target: "_blank", rel: "noopener" %>
      <span class="text-slate-300">•</span>
      <%= link_to "Privacy Policy", page_path(:privacy_policy), class: "hover:text-amber-700 no-underline" %>
      <span class="text-slate-300">•</span>
      <%= link_to "🐧 Prod App", ProdAppUrl, class: "hover:text-amber-700 no-underline", target: "_blank", rel: "noopener" %>
      <span class="text-slate-300">•</span>
      <%= link_to "🐙 GitHub", GithubCodeUrl, class: "hover:text-amber-700 no-underline", target: "_blank", rel: "noopener" %>
    </div>
  </div>
</footer>

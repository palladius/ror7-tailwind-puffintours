<%
  service = ActiveStorage::Blob.service
  has_local = service.respond_to?(:path_for) ? (File.exist?(service.path_for(blob.key)) rescue false) : false
  has_gcs = !has_local && blob.service_name != "local" && ((blob.created_at && blob.created_at > 10.minutes.ago) || (gcs_key_exists?(blob.key) rescue false))
  gcs_url = "https://storage.googleapis.com/#{GcsBucket}/#{blob.key}"
  fallback_img = asset_path("logo/puffin-suitcase.png")
  media_url = if has_local
    url_for(blob)
  elsif has_gcs
    gcs_url
  else
    blob.representable? ? fallback_img : gcs_url
  end
%>
<figure class="attachment attachment--<%= blob.representable? ? "preview" : "file" %> attachment--<%= blob.filename.extension %> my-4">
  <% if blob.video? %>
    <div class="rounded-2xl overflow-hidden bg-slate-900/95 border border-slate-700/80 shadow-md p-3 text-white max-w-xl">
      <video controls preload="metadata" class="w-full rounded-xl max-h-96 bg-black" src="<%= media_url %>">
        Your browser does not support HTML5 video.
      </video>
      <div class="mt-2.5 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-300 px-1">
        <div class="flex items-center gap-1.5 font-semibold text-amber-300">
          <span>🎬 <%= blob.filename %></span>
          <span class="text-slate-400">(<%= number_to_human_size blob.byte_size %>)</span>
        </div>
        <% unless has_local %>
          <span class="rounded-full bg-white/10 px-2.5 py-0.5 text-[11px] text-slate-300" title="gs://<%= GcsBucket %>/<%= blob.key %>">
            ☁️ GCS: <code><%= blob.key[0..9] %>…</code>
          </span>
        <% end %>
      </div>
    </div>
  <% elsif blob.audio? %>
    <div class="rounded-2xl bg-white/80 border border-slate-200 p-3 shadow-sm max-w-md">
      <audio controls class="w-full" src="<%= media_url %>"></audio>
      <div class="mt-1 text-xs text-slate-500">🎵 <%= blob.filename %> (<%= number_to_human_size blob.byte_size %>)</div>
    </div>
  <% elsif blob.representable? %>
    <%= image_tag media_url,
          class: "rounded-2xl shadow-sm max-h-[600px] w-auto object-contain",
          data: { fallback_src: fallback_img },
          onerror: "this.onerror=null;this.src='#{fallback_img}';" %>
    <figcaption class="attachment__caption text-xs text-slate-500 mt-1">
      <% if caption = blob.try(:caption) %>
        <%= caption %>
      <% else %>
        <span class="attachment__name font-semibold"><%= blob.filename %></span>
        <span class="attachment__size">(<%= number_to_human_size blob.byte_size %>)</span>
      <% end %>
    </figcaption>
  <% else %>
    <div class="inline-flex items-center gap-2 rounded-2xl bg-white/80 border border-slate-200 px-3.5 py-2 text-xs text-slate-700 shadow-sm">
      <span>📎 <b><%= blob.filename %></b></span>
      <span class="text-slate-400">(<%= number_to_human_size blob.byte_size %>)</span>
    </div>
  <% end %>
</figure>

<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-prefetch" content="false">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/favicon.ico">
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "trix", "actiontext" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body class="<%= body_class %>">
    <%= render "application/header" %>
    <%= render "application/flash_messages" %>
    <main class="flex-1">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <%= yield %>
      </div>
    </main>
    <%= render "application/footer" %>
    <%= render "application/remote_modal" %>
    <script>
      function repairBrokenImages() {
        document.querySelectorAll('img[data-fallback-src]').forEach((img) => {
          const fallback = img.getAttribute('data-fallback-src');
          if (!fallback) return;
          img.addEventListener('error', () => {
            if (img.src !== fallback) img.src = fallback;
          }, { once: true });
          if (img.complete && img.naturalWidth === 0 && img.src !== fallback) {
            img.src = fallback;
          }
        });
      }
      document.addEventListener('DOMContentLoaded', repairBrokenImages);
      document.addEventListener('turbo:load', repairBrokenImages);
      document.addEventListener('turbo:frame-load', repairBrokenImages);
      setTimeout(repairBrokenImages, 600);
    </script>
  </body>
</html>

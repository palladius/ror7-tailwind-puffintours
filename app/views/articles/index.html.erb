<%
  popular_tags = %w[puffintours barcelona spain carlessos puffin unicorn video test]
  active_tag = params[:tag].presence
%>

<!-- Glassmorphic Hero Header -->
<div class="glass-panel rounded-3xl p-6 sm:p-8 mb-8 relative overflow-hidden">
  <div class="absolute -right-10 -top-10 h-44 w-44 rounded-full bg-gradient-to-br from-amber-400/25 to-orange-500/20 blur-2xl pointer-events-none"></div>
  <div class="absolute -left-10 -bottom-10 h-44 w-44 rounded-full bg-gradient-to-tr from-sky-400/25 to-indigo-500/20 blur-2xl pointer-events-none"></div>

  <div class="relative flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full bg-amber-500/15 border border-amber-500/30 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-900 mb-3">
        <span>🐧 Puffin Tours Journal</span>
        <span>•</span>
        <span><%= Article.count %> Stories</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 my-0">
        Family Trips &amp; <span class="bg-gradient-to-r from-amber-600 via-orange-600 to-rose-600 bg-clip-text text-transparent">AI Chronicles</span>
      </h1>
      <p class="mt-2 mb-0 text-sm sm:text-base text-slate-600 max-w-2xl">
        Explore Carlesso family adventures, Trix media experiments, and Gemini-summarized travel notes — rendered as frosted glassmorphic cards or an interactive <b>A2UI</b> surface.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <!-- A2UI / Glass View Switcher -->
      <div class="inline-flex items-center rounded-full bg-slate-900/5 p-1 border border-slate-300/60 backdrop-blur-md">
        <button type="button" id="btn-view-glass" onclick="switchPuffinView('glass')" class="rounded-full px-3.5 py-1.5 text-xs font-bold bg-white text-slate-900 shadow-sm transition-all">
          ✨ Glass Cards
        </button>
        <button type="button" id="btn-view-a2ui" onclick="switchPuffinView('a2ui')" class="rounded-full px-3.5 py-1.5 text-xs font-bold text-slate-600 hover:text-slate-900 transition-all">
          🎛️ A2UI Surface
        </button>
      </div>

      <%= link_to new_article_path, class: 'btn' do %>
        <%= heroicon "plus" %>
        <span>New Article</span>
      <% end %>
    </div>
  </div>

  <!-- Search & Tag Filters -->
  <div class="relative mt-6 pt-6 border-t border-slate-200/60 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="w-full md:max-w-md">
      <%= search_form_for @q, data: { turbo_frame: "search" } do |f| %>
        <div class="relative">
          <div class="flex absolute inset-y-0 left-0 items-center pl-4 pointer-events-none text-slate-400">
            <%= heroicon "magnifying-glass", options: { class: "w-5 h-5" } %>
          </div>
          <%= f.text_field :title_or_body_cont,
                class: "search-input w-full !mt-0 !mb-0 pl-11 pr-4 py-3 text-sm rounded-full bg-white/85 border border-slate-200/90 shadow-inner focus:border-amber-500 focus:ring-2 focus:ring-amber-200",
                onkeyup: "search()",
                placeholder: "Search stories, places, or Gemini summaries..." %>
        </div>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center gap-1.5">
      <%= link_to "All Stories", articles_path,
            class: "rounded-full px-3 py-1 text-xs font-semibold no-underline transition-all #{active_tag.blank? ? 'bg-slate-900 text-white shadow-sm' : 'glass-pill text-slate-700 hover:text-amber-800'}" %>
      <% popular_tags.each do |tag_name| %>
        <%= link_to "##{tag_name}", "/tags/#{tag_name}",
              class: "rounded-full px-3 py-1 text-xs font-semibold no-underline transition-all #{active_tag == tag_name ? 'bg-amber-600 text-white shadow-sm' : 'glass-pill text-slate-700 hover:text-amber-800'}" %>
      <% end %>
    </div>
  </div>
</div>

<!-- A2UI Declarative Surface View (Toggled via "🎛️ A2UI Surface") -->
<section id="puffin-a2ui-view" class="hidden mb-10">
  <div class="glass-panel rounded-3xl p-6 sm:p-8 border-2 border-amber-400/50">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 mb-6 border-b border-slate-200/70">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-500/15 border border-indigo-500/30 px-3 py-0.5 text-xs font-bold text-indigo-900">
          ⚡ Google A2UI (Agent-to-User Interface) v1.0
        </span>
        <h2 class="text-2xl font-extrabold text-slate-900 mt-1 mb-0">Declarative Blog Surface</h2>
        <p class="text-xs sm:text-sm text-slate-600 my-1">
          Interactive component tree (<code>Card</code>, <code>Row</code>, <code>Column</code>, <code>ChoicePicker</code>, <code>Slider</code>, <code>Tabs</code>) bound to reactive state <code>$/blog/*</code>.
        </p>
      </div>
      <button type="button" onclick="document.getElementById('a2ui-dsl-modal').classList.toggle('hidden')" class="btn btn-outline btn-sm">
        📄 View &lt;a2ui&gt; DSL Spec
      </button>
    </div>

    <!-- Collapsible raw <a2ui> Express DSL -->
    <div id="a2ui-dsl-modal" class="hidden mb-6 rounded-2xl bg-slate-950 text-slate-100 p-5 text-xs font-mono overflow-x-auto shadow-inner">
<pre class="leading-relaxed text-amber-200">&lt;a2ui&gt;
surface("puffin_tours_blog")
$/blog/query = ""
$/blog/category = "All"
$/blog/maxCards = 6

header = Row([
  Column([
    Text("🐧 Puffin Tours — A2UI Travel Explorer", "h1"),
    Text("Reactive Generative UI powered by Rails 8 + Gemini 2.5 Flash", "caption")
  ]),
  Button("➕ New Story", action=Event("navigate", {url: "/articles/new"}), variant="primary")
], justify="spaceBetween", align="center")

controls = Card(Row([
  TextField("Search Filter", $/blog/query, "Filter by title or AI summary...", "shortText"),
  ChoicePicker("Category", ["All", "AI Summarized", "With Cloud Media", "Public"], $/blog/category, "mutuallyExclusive"),
  Slider("Max Cards", 2, 10, $/blog/maxCards)
], justify="spaceBetween", align="center"))

feed = List(children=bind($/blog/filteredArticles, item =&gt;
  Card(Column([
    Image(item.coverUrl, altText=item.title, variant="banner"),
    Row([Text(item.author, "caption"), Text(item.date, "caption")], justify="spaceBetween"),
    Text(item.title, "h3"),
    Text(item.synopsis, "body"),
    Row([
      Button("Read Story", action=Event("open_article", {id: item.id}), variant="primary"),
      Button("✍️ Edit", action=Event("edit_article", {id: item.id}), variant="secondary")
    ], justify="spaceBetween")
  ]))
))

root = Column([header, controls, feed])
&lt;/a2ui&gt;</pre>
    </div>

    <!-- Live Reactive A2UI Controls -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6 p-4 rounded-2xl bg-white/70 border border-white/90">
      <div>
        <label class="text-xs font-bold uppercase tracking-wider text-slate-500">A2UI TextField (<code>$/blog/query</code>)</label>
        <input type="text" id="a2ui-input-query" oninput="renderA2uiFeed()" placeholder="Type to filter A2UI cards..." class="!mt-1 !mb-0 w-full rounded-xl text-sm py-2 px-3" />
      </div>
      <div>
        <label class="text-xs font-bold uppercase tracking-wider text-slate-500">A2UI ChoicePicker (<code>$/blog/category</code>)</label>
        <select id="a2ui-select-cat" onchange="renderA2uiFeed()" class="!mt-1 !mb-0 w-full rounded-xl text-sm py-2 px-3">
          <option value="all">All Stories</option>
          <option value="ai">✨ Has Gemini AI Synopsis</option>
          <option value="media">☁️ Has Attached Media</option>
        </select>
      </div>
      <div>
        <label class="text-xs font-bold uppercase tracking-wider text-slate-500">
          A2UI Slider (<code>$/blog/maxCards</code>): <span id="a2ui-slider-val" class="text-amber-700 font-extrabold">6</span>
        </label>
        <input type="range" id="a2ui-slider-max" min="2" max="10" value="6" oninput="renderA2uiFeed()" class="w-full accent-amber-600 mt-3 cursor-pointer" />
      </div>
    </div>

    <div id="a2ui-cards-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"></div>
  </div>
</section>

<!-- Main Frosted Glassmorphic Cards Grid -->
<div id="puffin-glass-view">
  <%= turbo_frame_tag "search", target: "_top" do %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      <% @articles.each do |article| %>
        <%
          ai_synopsis = clean_gemini_synopsis(article)
          body_excerpt = clean_body_excerpt(article, ai_synopsis.present? ? 100 : 165)
          author_name = article.user&.name.presence || "Puffin"
        %>
        <article class="card card-interactive group">
          <div>
            <!-- Rounded Visual Cover with Floating Glass Badges -->
            <%= render_card_cover(article) %>

            <!-- Author + Date + Quick Edit Row -->
            <div class="flex items-center justify-between gap-2 mb-2.5">
              <div class="flex items-center gap-2 text-xs text-slate-500 min-w-0">
                <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-amber-500 to-orange-600 text-[11px] font-bold text-white shadow-sm">
                  <%= author_name[0].upcase %>
                </span>
                <span class="font-semibold text-slate-700 truncate"><%= author_name.capitalize %></span>
                <span class="text-slate-300">·</span>
                <span class="text-slate-400 shrink-0"><%= (article.content_date || article.created_at&.to_date).to_s %></span>
              </div>

              <% if article.editable_by?(current_user) %>
                <div class="card-action-z flex items-center gap-1.5">
                  <%= link_to edit_article_path(article),
                        class: "inline-flex items-center gap-1 rounded-full bg-amber-500/10 hover:bg-amber-500/25 border border-amber-500/30 px-2.5 py-0.5 text-xs font-semibold text-amber-800 no-underline transition-colors",
                        title: "Edit #{article.title}" do %>
                    <span>✍️ Edit</span>
                  <% end %>
                  <%= button_to article_path(article),
                        method: :delete,
                        form: { data: { turbo_confirm: "Destroy '#{article.title}'?" }, class: "inline-block m-0" },
                        class: "inline-flex items-center gap-1 rounded-full bg-rose-500/10 hover:bg-rose-600 hover:text-white border border-rose-500/30 px-2.5 py-0.5 text-xs font-semibold text-rose-700 transition-colors cursor-pointer",
                        title: "Destroy #{article.title}" do %>
                    <span>🗑️</span>
                  <% end %>
                </div>
              <% end %>
            </div>

            <!-- Card Title with stretched .card-link -->
            <h3 class="card-title mb-3">
              <%= link_to article.title, article, class: "card-link" %>
            </h3>

            <!-- Gemini AI Summary Glass Callout (only when meaningful) -->
            <% if ai_synopsis.present? %>
              <div class="mb-3 rounded-2xl bg-gradient-to-br from-amber-50/90 via-white/85 to-sky-50/85 border border-amber-300/60 p-3.5 shadow-inner">
                <div class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-amber-800 mb-1">
                  <span>✨ Gemini AI Synopsis</span>
                </div>
                <p class="m-0 text-xs sm:text-sm text-slate-700 leading-relaxed line-clamp-3">
                  <%= ai_synopsis %>
                </p>
              </div>
            <% else %>
              <div class="card-body">
                <p class="m-0 text-sm text-slate-600 leading-relaxed line-clamp-3">
                  <%= body_excerpt %>
                </p>
              </div>
            <% end %>

            <!-- Tag Pills -->
            <% if article.tags.any? %>
              <div class="mt-3 flex flex-wrap gap-1.5">
                <%= render_tags(article) %>
              </div>
            <% end %>
          </div>

          <!-- Card Footer Actions -->
          <div class="card-actions">
            <div class="flex items-center gap-3 text-xs font-semibold text-slate-500">
              <span title="Likes">👍 <%= article.votes_for.size %></span>
              <span title="Comments">💬 <%= article.comments.size %></span>
            </div>

            <%= link_to article, class: "card-action-z inline-flex items-center gap-1.5 rounded-full bg-slate-900/5 hover:bg-amber-500 hover:text-white text-slate-800 px-4 py-1.5 text-xs font-bold transition-all no-underline" do %>
              <span>Read story</span>
              <span class="sr-only"> about <%= article.title %></span>
              <span aria-hidden="true">→</span>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>

    <div class="text-center mt-12">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>

<script>
  const PUFFIN_A2UI_DATA = <%= raw(
    @articles.map { |a|
      syn = clean_gemini_synopsis(a)
      {
        id: a.id,
        title: a.title,
        author: (a.user&.name || "Puffin").capitalize,
        date: (a.content_date || a.created_at&.to_date).to_s,
        hasAi: syn.present?,
        hasMedia: a.main_image&.attached? || false,
        synopsis: syn.presence || clean_body_excerpt(a, 140),
        coverUrl: local_blob_available?(a) ? url_for(a.main_image) : asset_path(fallback_puffin_asset(a)),
        url: article_path(a),
        editUrl: edit_article_path(a)
      }
    }.to_json
  ) %>;

  function switchPuffinView(mode) {
    const glassEl = document.getElementById('puffin-glass-view');
    const a2uiEl = document.getElementById('puffin-a2ui-view');
    const btnGlass = document.getElementById('btn-view-glass');
    const btnA2ui = document.getElementById('btn-view-a2ui');
    if (mode === 'a2ui') {
      glassEl.classList.add('hidden');
      a2uiEl.classList.remove('hidden');
      btnA2ui.className = 'rounded-full px-3.5 py-1.5 text-xs font-bold bg-amber-500 text-white shadow-sm transition-all';
      btnGlass.className = 'rounded-full px-3.5 py-1.5 text-xs font-bold text-slate-600 hover:text-slate-900 transition-all';
      renderA2uiFeed();
    } else {
      a2uiEl.classList.add('hidden');
      glassEl.classList.remove('hidden');
      btnGlass.className = 'rounded-full px-3.5 py-1.5 text-xs font-bold bg-white text-slate-900 shadow-sm transition-all';
      btnA2ui.className = 'rounded-full px-3.5 py-1.5 text-xs font-bold text-slate-600 hover:text-slate-900 transition-all';
    }
  }

  function renderA2uiFeed() {
    const q = (document.getElementById('a2ui-input-query')?.value || '').toLowerCase();
    const cat = document.getElementById('a2ui-select-cat')?.value || 'all';
    const max = parseInt(document.getElementById('a2ui-slider-max')?.value || '6', 10);
    const valSpan = document.getElementById('a2ui-slider-val');
    if (valSpan) valSpan.textContent = max;

    const filtered = PUFFIN_A2UI_DATA.filter(item => {
      const matchesQ = !q || item.title.toLowerCase().includes(q) || item.synopsis.toLowerCase().includes(q);
      const matchesCat = cat === 'all' || (cat === 'ai' && item.hasAi) || (cat === 'media' && item.hasMedia);
      return matchesQ && matchesCat;
    }).slice(0, max);

    const container = document.getElementById('a2ui-cards-container');
    if (!container) return;

    container.innerHTML = filtered.map(item => `
      <div class="rounded-3xl bg-white/85 backdrop-blur-md border border-slate-200/90 p-5 shadow-md flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
            <span class="font-bold text-indigo-700">A2UI::Card #${item.id}</span>
            <span>${item.date}</span>
          </div>
          <h4 class="text-lg font-extrabold text-slate-900 mb-2">${item.title}</h4>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">${item.synopsis}</p>
        </div>
        <div class="flex items-center justify-between pt-3 border-t border-slate-100">
          <span class="text-xs font-semibold text-slate-500">by ${item.author}</span>
          <a href="${item.url}" class="rounded-full bg-indigo-600 hover:bg-indigo-700 text-white px-3.5 py-1 text-xs font-bold no-underline">Open Surface →</a>
        </div>
      </div>
    `).join('');
  }
</script>

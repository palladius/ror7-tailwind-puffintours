<%= form_with(model: article) do |form| %>
  <%= render "application/error_messages", object: article %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <!-- Upload MainImage https://edgeguides.rubyonrails.org/active_storage_overview.html -->
  <div>
    <%= form.file_field :main_image, multiple: false, direct_upload: true %>
  </div>

  <div>
    <%= form.label :tags_list %>
    <!-- genio: https://stackoverflow.com/questions/27646714/rails-4-text-field-for-acts-as-taggable-on-not-separating-tags-with-a-comma -->
    <% tag_list = "tag_list" %>
    <%= form.text_field :tag_list, value: @article.tag_list.to_s, :placeholder => "Comma-separated list of tag", class: 'form-control' %>
  </div>

  <div>
    <%= form.label :content_date %>
    <%= form.date_field :content_date %>
  </div>

  <div>
    <%= form.label :article_type %>
    <%= form.text_field :article_type %>
  </div>

  <div>
    <%= form.label :published %>
    <%= form.check_box :published %>
  </div>

  <div>
    <%= form.label :body %>
    <div id="trix-upload-status" class="hidden my-2 rounded-xl bg-amber-50 border border-amber-300 px-3.5 py-2 text-xs font-semibold text-amber-900"></div>
    <%= form.rich_text_area :body %>
  </div>

  <h2>AI side (Gemini should populate it, but in DEV or as an admin you can do it too)</h2>
  <!-- TODO: make it a button to generate it -->
  <div>
    <%= form.label :article_synopsis %>
    <%= form.text_area :article_synopsis %>
  </div>
  <div>
    <%= form.label :main_image_synopsis %>
    <%= form.text_area :main_image_synopsis %>
  </div>

  <div class="mt-4">
    <%= form.submit nil, class: 'btn', id: 'article-submit-btn' %>
  </div>
<% end %>

<script>
  (function() {
    if (window._puffinTrixAddHandler) {
      document.removeEventListener('trix-attachment-add', window._puffinTrixAddHandler);
    }
    if (window._puffinTrixRemoveHandler) {
      document.removeEventListener('trix-attachment-remove', window._puffinTrixRemoveHandler);
    }
    if (window._puffinDirectUploadProgressHandler) {
      document.removeEventListener('direct-upload:progress', window._puffinDirectUploadProgressHandler);
    }
    if (window._puffinDirectUploadErrorHandler) {
      document.removeEventListener('direct-upload:error', window._puffinDirectUploadErrorHandler);
    }

    const activeAttachments = new Set();

    const updateSubmitState = (errorMsg) => {
      const btn = document.getElementById('article-submit-btn');
      const status = document.getElementById('trix-upload-status');
      if (!btn || !status) return;

      if (errorMsg) {
        btn.disabled = false;
        btn.style.opacity = '1';
        status.className = 'my-2 rounded-xl bg-rose-50 border border-rose-300 px-3.5 py-2 text-xs font-semibold text-rose-900';
        status.textContent = `⚠️ Upload error: ${errorMsg}`;
        return;
      }

      if (activeAttachments.size > 0) {
        btn.disabled = true;
        btn.style.opacity = '0.6';
        status.className = 'my-2 rounded-xl bg-amber-50 border border-amber-300 px-3.5 py-2 text-xs font-semibold text-amber-900';
        status.textContent = `☁️ Uploading ${activeAttachments.size} attachment(s) to Google Cloud Storage (gs://<%= GcsBucket %>)...`;
      } else {
        btn.disabled = false;
        btn.style.opacity = '1';
        if (status.textContent.includes('Uploading')) {
          status.className = 'my-2 rounded-xl bg-emerald-50 border border-emerald-300 px-3.5 py-2 text-xs font-semibold text-emerald-900';
          status.textContent = '✅ Image uploaded to Google Cloud Storage (gs://<%= GcsBucket %>)! Ready to save.';
        }
      }
    };

    window._puffinTrixAddHandler = (event) => {
      const att = event.attachment;
      if (!att || !att.file) return;

      activeAttachments.add(att);
      updateSubmitState();

      // ActionText AttachmentUpload sets sgid on the Trix attachment when the GCS PUT completes
      // (it does NOT dispatch the DOM event direct-upload:end). Poll until sgid is set (max 45s).
      const startedAt = Date.now();
      const timer = setInterval(() => {
        const hasSgid = att.getAttribute && (att.getAttribute('sgid') || att.getAttribute('url'));
        const timedOut = (Date.now() - startedAt) > 45000;
        if (hasSgid || timedOut) {
          clearInterval(timer);
          activeAttachments.delete(att);
          updateSubmitState(timedOut && !hasSgid ? 'Upload timed out, please try again.' : null);
        }
      }, 150);
    };

    window._puffinTrixRemoveHandler = (event) => {
      if (event.attachment) {
        activeAttachments.delete(event.attachment);
        updateSubmitState();
      }
    };

    window._puffinDirectUploadProgressHandler = (event) => {
      const status = document.getElementById('trix-upload-status');
      if (!status) return;
      const pct = event.detail && event.detail.progress ? Math.round(event.detail.progress) : 0;
      status.className = 'my-2 rounded-xl bg-amber-50 border border-amber-300 px-3.5 py-2 text-xs font-semibold text-amber-900';
      status.textContent = `☁️ Uploading cover image to Google Cloud Storage (gs://<%= GcsBucket %>)... ${pct}%`;
    };

    window._puffinDirectUploadErrorHandler = (event) => {
      const error = (event.detail && event.detail.error) || 'Direct upload to GCS failed';
      updateSubmitState(error);
    };

    document.addEventListener('trix-attachment-add', window._puffinTrixAddHandler);
    document.addEventListener('trix-attachment-remove', window._puffinTrixRemoveHandler);
    document.addEventListener('direct-upload:progress', window._puffinDirectUploadProgressHandler);
    document.addEventListener('direct-upload:error', window._puffinDirectUploadErrorHandler);
  })();
</script>

<%= form_with(model: article) do |form| %>
  <%= render "application/error_messages", object: article %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <!-- Upload MainImage https://edgeguides.rubyonrails.org/active_storage_overview.html -->
  <div>
    <%= form.file_field :main_image, multiple: false, direct_upload: true %>
  </div>

  <div>
    <%= form.label :tags_list %>
    <!-- genio: https://stackoverflow.com/questions/27646714/rails-4-text-field-for-acts-as-taggable-on-not-separating-tags-with-a-comma -->
    <% tag_list = "tag_list" %>
    <%= form.text_field :tag_list, value: @article.tag_list.to_s, :placeholder => "Comma-separated list of tag", class: 'form-control' %>
  </div>

  <div>
    <%= form.label :content_date %>
    <%= form.date_field :content_date %>
  </div>

  <div>
    <%= form.label :article_type %>
    <%= form.text_field :article_type %>
  </div>

  <div>
    <%= form.label :published %>
    <%= form.check_box :published %>
  </div>

  <div>
    <%= form.label :body %>
    <div id="trix-upload-status" class="hidden my-2 rounded-xl bg-amber-50 border border-amber-300 px-3.5 py-2 text-xs font-semibold text-amber-900"></div>
    <%= form.rich_text_area :body %>
  </div>

  <h2>AI side (Gemini should populate it, but in DEV or as an admin you can do it too)</h2>
  <!-- TODO: make it a button to generate it -->
  <div>
    <%= form.label :article_synopsis %>
    <%= form.text_area :article_synopsis %>
  </div>
  <div>
    <%= form.label :main_image_synopsis %>
    <%= form.text_area :main_image_synopsis %>
  </div>

  <div class="mt-4">
    <%= form.submit nil, class: 'btn', id: 'article-submit-btn' %>
  </div>
<% end %>

<script>
  (function() {
    let pendingTrixUploads = 0;
    const updateSubmitState = () => {
      const btn = document.getElementById('article-submit-btn');
      const status = document.getElementById('trix-upload-status');
      if (!btn || !status) return;
      if (pendingTrixUploads > 0) {
        btn.disabled = true;
        btn.style.opacity = '0.6';
        status.classList.remove('hidden');
        status.textContent = `☁️ Uploading ${pendingTrixUploads} attachment(s) to Google Cloud Storage (gs://<%= GcsBucket %>)... please wait before saving.`;
      } else {
        btn.disabled = false;
        btn.style.opacity = '1';
        if (status.textContent.includes('Uploading')) {
          status.textContent = '✅ Attachment uploaded to Google Cloud Storage! Ready to save.';
        }
      }
    };

    document.addEventListener('trix-attachment-add', (event) => {
      if (event.attachment && event.attachment.file) {
        pendingTrixUploads++;
        updateSubmitState();
      }
    });

    document.addEventListener('direct-upload:end', () => {
      if (pendingTrixUploads > 0) pendingTrixUploads--;
      updateSubmitState();
    });

    document.addEventListener('direct-upload:error', (event) => {
      if (pendingTrixUploads > 0) pendingTrixUploads--;
      const status = document.getElementById('trix-upload-status');
      if (status) {
        status.classList.remove('hidden');
        status.textContent = `⚠️ Upload error: ${event.detail?.error || 'Direct upload failed'}`;
      }
      const btn = document.getElementById('article-submit-btn');
      if (btn) { btn.disabled = false; btn.style.opacity = '1'; }
    });
  })();
</script>

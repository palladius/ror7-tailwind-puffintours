<% if comment.persisted? %>
  <div id="<%= dom_id comment %>" class="py-2.5 border-b border-slate-200/60 last:border-b-0 flex items-start justify-between gap-2 text-xs">
    <div class="space-y-0.5">
      <div class="flex items-center gap-1.5">
        <% if comment.vote.to_i > 0 %>
          <span class="text-amber-500 tracking-tight font-bold" aria-label="<%= comment.vote %> out of 5 stars">
            <%= "★" * comment.vote.to_i %><span class="text-slate-300"><%= "★" * (5 - comment.vote.to_i) %></span>
          </span>
        <% end %>
        <span class="font-semibold text-slate-600"><%= comment.user&.name || "Anon" %></span>
      </div>
      <% if comment.body.to_s.strip.present? %>
        <p class="m-0 text-slate-700 leading-snug"><%= comment.body.to_s.chomp %></p>
      <% end %>
    </div>

    <% if current_user && (current_user.admin? || current_user == comment.user) %>
      <%= button_to [comment.article, comment],
            method: :delete,
            form: { class: "inline-block m-0" },
            class: "text-slate-400 hover:text-rose-600 transition-colors cursor-pointer bg-transparent border-0 p-0.5",
            title: "Delete comment" do %>
        ✕
      <% end %>
    <% end %>
  </div>
<% end %>
